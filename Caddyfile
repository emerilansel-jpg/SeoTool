# SeoTool.im reverse proxy with marketing static files + SaaS app fallback.
# Caddy automatically obtains and renews Let's Encrypt TLS certificates.
#
# Marketing routes are served as static files from /srv/marketing.
# Everything else is proxied to the SaaS app (open-seo:3001).

seotool.im {
    # Known marketing site routes. These are served as static HTML.
    # Legal pages (/privacy, /terms-and-conditions, /cookie-policy,
    # /refund-policy, /dpa) and /blogs* are served by the SaaS app from
    # the CMS tables instead.
    @marketingRoutes {
        path /about /contact /careers /affiliates /changelog
        path /features /features/*
        path /free-tools /free-tools/*
        path /open-source-seo /google-search-console-mcp
    }
    handle @marketingRoutes {
        root * /srv/marketing
        try_files {path} {path}/index.html /index.html
        file_server
    }

    # Marketing static assets (images, videos, avatars, blog).
    # NOTE: /assets/* is intentionally EXCLUDED here. The SaaS app also
    # serves its JS/CSS bundles under /assets/. /assets/* is handled
    # separately below with a file matcher.
    @marketingAssets {
        path /avatars/* /blog/*
        path /demo.mp4 /demo-poster.webp
        path /favicon* /apple-touch-icon* /android-chrome*
        path /site.webmanifest /robots.txt /sitemap.xml /social-card.png /product-hunt.svg
    }
    handle @marketingAssets {
        root * /srv/marketing
        file_server
    }

    # /assets/* is shared by the marketing site AND the SaaS app. Serve the
    # file from marketing only when it actually exists there; otherwise let
    # it fall through to the catch-all handle below which proxies to the SaaS
    # app (so SaaS route chunks load correctly).
    @marketingAssetFile {
        path /assets/*
        file {
            root /srv/marketing
        }
    }
    handle @marketingAssetFile {
        root * /srv/marketing
        file_server
    }

    # Docs, guides content (marketing subpaths). /blogs* is EXCLUDED:
    # blog posts are served by the SaaS app from the cms_posts table.
    @marketingContent {
        path /docs* /guides* /library*
    }
    handle @marketingContent {
        root * /srv/marketing
        try_files {path} {path}/index.html /index.html
        file_server
    }

    # Everything else goes to the SaaS app (sign-in, dashboard, API, etc.)
    handle {
        reverse_proxy open-seo:3001 {
            header_up Host localhost
        }
    }

    encode gzip zstd

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # WebSocket support for SAM chat and onboarding agents
    @websockets {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @websockets open-seo:3001 {
        header_up Host localhost
    }
}

# Redirect www to apex
www.seotool.im {
    redir https://seotool.im{uri} permanent
}
