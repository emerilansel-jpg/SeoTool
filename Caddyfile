# ============================================================
# Caddyfile — SeoTool.im production configuration
# ============================================================
# Used by the shared gateway-caddy container on the production VPS.
# Sits behind Cloudflare (Full SSL). Caddy handles automatic HTTPS
# with Let's Encrypt / ZeroSSL, or uses Cloudflare Origin CA certs.
#
# Static marketing site files: /srv/marketing
# SaaS application:            http://open-seo:3001 (Docker network)
# ============================================================

seotool.im {
    # Marketing static media assets (images, videos, avatars, blog media, icons).
    @marketingAssets {
        path /avatars/* /blog/* /integrations/*
        path /demo.mp4 /demo-poster.webp
        path /favicon* /apple-touch-icon* /android-chrome*
        path /site.webmanifest /robots.txt /sitemap.xml /social-card.png /product-hunt.svg
        path /logo* /transparent-logo*
    }
    handle @marketingAssets {
        root * /srv/marketing
        file_server
    }

    # Redirect all legacy marketing pages to new routes
    redir /about / permanent
    redir /careers / permanent
    redir /contact / permanent
    redir /affiliates / permanent
    redir /open-source-seo /features permanent
    redir /google-search-console-mcp /features permanent
    redir /docs* /features permanent
    redir /guides* /features permanent
    redir /library* /features permanent
    redir /free-tools* /features permanent

    # SaaS app bundles under /assets/* use content-hashed filenames, so they
    # can be cached immutably.
    handle /assets/* {
        reverse_proxy open-seo:3001 {
            header_up Host localhost
        }
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # Everything else goes to the SaaS app (/, /pricing, /changelog, dashboard, API, etc.)
    handle {
        reverse_proxy open-seo:3001 {
            header_up Host localhost
        }
    }

    encode gzip zstd

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # WebSocket support for SAM chat and onboarding agents
    @websockets {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @websockets open-seo:3001 {
        header_up Host localhost
    }
}

# Redirect www to apex
www.seotool.im {
    redir https://seotool.im{uri} permanent
}
