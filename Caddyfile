# SeoTool.im reverse proxy with marketing static files + SaaS app fallback.
# Caddy automatically obtains and renews Let's Encrypt TLS certificates.
#
# Marketing routes are served as static files from /srv/marketing.
# Everything else is proxied to the SaaS app (open-seo:3001).

seotool.im {
    # Known marketing site routes. These are served as static HTML.
    # Add new marketing routes here when they are created.
    @marketingRoutes {
        path / /pricing /about /contact /careers /affiliates /changelog
        path /features /features/*
        path /open-source-seo /google-search-console-mcp
        path /privacy /terms-and-conditions /cookie-policy /refund-policy /dpa
    }
    handle @marketingRoutes {
        root * /srv/marketing
        try_files {path} {path}/index.html /index.html
        file_server
    }

    # Marketing static assets (CSS, JS, images, videos)
    @marketingAssets {
        path /assets/* /avatars/* /demo.mp4 /demo-poster.webp
        path /favicon* /apple-touch-icon* /android-chrome*
        path /site.webmanifest /robots.txt /sitemap.xml
    }
    handle @marketingAssets {
        root * /srv/marketing
        file_server
    }

    # Blog, docs, guides content (marketing subpaths)
    @marketingContent {
        path /blogs* /docs* /guides*
    }
    handle @marketingContent {
        root * /srv/marketing
        try_files {path} {path}/index.html /index.html
        file_server
    }

    # Everything else goes to the SaaS app (sign-in, dashboard, API, etc.)
    handle {
        reverse_proxy open-seo:3001
    }

    encode gzip zstd

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # WebSocket support for SAM chat and onboarding agents
    @websockets {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @websockets open-seo:3001
}

# Redirect www to apex
www.seotool.im {
    redir https://seotool.im{uri} permanent
}
