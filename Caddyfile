# SeoTool.im reverse proxy with marketing static files + SaaS app fallback.
# Caddy automatically obtains and renews Let's Encrypt TLS certificates.

seotool.im {
    # Marketing static files (prerendered HTML from web/dist/client).
    # Caddy checks if a static file exists for the request path. If it does,
    # serve it directly. If not, fall through to the SaaS reverse proxy.
    root * /srv/marketing

    @staticFiles {
        file {
            try_files {path} {path}/index.html
        }
    }
    handle @staticFiles {
        file_server
    }

    # Everything else goes to the SaaS app (sign-in, dashboard, API, etc.)
    handle {
        reverse_proxy open-seo:3001
    }

    encode gzip zstd

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # WebSocket support for SAM chat and onboarding agents
    @websockets {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @websockets open-seo:3001
}

# Redirect www to apex
www.seotool.im {
    redir https://seotool.im{uri} permanent
}
