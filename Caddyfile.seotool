# ============================================================
# SeoTool.im — Dedicated Caddyfile (separated from pesat)
# ============================================================
# Sits BEHIND pesat-caddy on the shared docker network (internal only,
# no host ports). pesat-caddy terminates TLS for seotool.im and forwards
# to this container over plain HTTP. All SeoTool routing (marketing
# static files + SaaS reverse proxy) lives here, not in pesat.
# ============================================================

:80 {
    encode gzip zstd

    # Marketing static files (prerendered HTML from web/dist/client).
    # Content marketing routes are served as static files from /srv/marketing.
    # Homepage (/) and /pricing are handled directly by the SaaS app
    # (open-seo:3001). Legal pages (/privacy, /terms-and-conditions,
    # /cookie-policy, /refund-policy, /dpa) and /blogs* are served by the
    # SaaS app from the CMS tables instead.
    @marketingRoutes {
        path /about /contact /careers /affiliates /changelog
        path /features /features/*
        path /free-tools /free-tools/*
        path /open-source-seo /google-search-console-mcp
        path /privacy /terms-and-conditions /refund-policy /cookie-policy /dpa
    }
    handle @marketingRoutes {
        root * /srv/marketing
        try_files {path} {path}/index.html /index.html
        file_server
    }

    # Marketing static assets (images, videos, avatars, blog).
    # NOTE: /assets/* is intentionally EXCLUDED here. The SaaS app also
    # serves its JS/CSS bundles under /assets/. /assets/* is handled
    # separately below with a file matcher.
    @marketingAssets {
        path /avatars/* /blog/*
        path /demo.mp4 /demo-poster.webp
        path /favicon* /apple-touch-icon* /android-chrome*
        path /site.webmanifest /robots.txt /sitemap.xml /social-card.png /product-hunt.svg
        path /agent-onboarding /js/*
        path /logo* /transparent-logo*
    }
    handle @marketingAssets {
        root * /srv/marketing
        file_server
    }

    # /assets/* is shared by the marketing site AND the SaaS app. Serve the
    # file from marketing only when it actually exists there; otherwise let
    # it fall through to the catch-all handle below which proxies to the SaaS
    # app (so SaaS route chunks load correctly).
    @marketingAssetFile {
        path /assets/*
        file {
            root /srv/marketing
        }
    }
    handle @marketingAssetFile {
        root * /srv/marketing
        file_server
    }

    # Marketing routes, docs, guides, library, and feature pages.
    @marketingContent {
        path /docs* /guides* /library* /features* /free-tools*
        path /about /contact /careers /affiliates /open-source-seo /google-search-console-mcp
    }
    handle @marketingContent {
        root * /srv/marketing
        try_files {path} {path}/index.html /index.html
        file_server
    }

    # Everything else goes to the SaaS app.
    # header_up Host localhost: Vite preview server rejects non-localhost
    # Host headers ("Blocked request. This host ... is not allowed").
    handle {
        reverse_proxy open-seo:3001 {
            header_up Host localhost
        }
    }

    header {
        Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://challenges.cloudflare.com https://us-assets.i.posthog.com https://eu-assets.i.posthog.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://t0.gstatic.com https://t2.gstatic.com https://api.qrserver.com https://unpkg.com https://*.tile.openstreetmap.org; connect-src 'self' https://us.i.posthog.com https://eu.i.posthog.com https://us-assets.i.posthog.com https://eu-assets.i.posthog.com https://cloudflareinsights.com https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'; report-uri /api/csp-report;"
    }
    @websockets {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @websockets open-seo:3001 {
        header_up Host localhost
    }
}
