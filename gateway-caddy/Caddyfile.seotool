# ============================================================
# SeoTool.im — Dedicated Caddyfile (separated from pesat)
# ============================================================
# Sits BEHIND pesat-caddy on the shared docker network (internal only,
# no host ports). pesat-caddy terminates TLS for seotool.im and forwards
# to this container over plain HTTP. All SeoTool routing (marketing
# static media files + SaaS reverse proxy) lives here, not in pesat.
# ============================================================

:80 {
    encode gzip zstd

    # Marketing static media assets (images, videos, avatars, blog media, icons).
    @marketingAssets {
        path /avatars/* /blog/*
        path /demo.mp4 /demo-poster.webp
        path /favicon* /apple-touch-icon* /android-chrome*
        path /site.webmanifest /robots.txt /sitemap.xml /social-card.png /product-hunt.svg
        path /logo* /transparent-logo*
    }
    handle @marketingAssets {
        root * /srv/marketing
        file_server
    }

    # Redirect all legacy marketing pages to new routes
    redir /about / permanent
    redir /careers / permanent
    redir /contact / permanent
    redir /affiliates / permanent
    redir /open-source-seo /features permanent
    redir /google-search-console-mcp /features permanent
    redir /docs* /features permanent
    redir /guides* /features permanent
    redir /library* /features permanent
    redir /free-tools* /features permanent

    # SaaS app bundles under /assets/* use content-hashed filenames
    handle /assets/* {
        reverse_proxy open-seo:3001 {
            header_up Host localhost
        }
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # Everything else (/, /pricing, /changelog, /blogs, /features, /privacy, /terms-and-conditions, /refund-policy, /sign-in, dashboard, API, etc.)
    # goes directly to the modern SaaS app.
    handle {
        reverse_proxy open-seo:3001 {
            header_up Host localhost
        }
    }

    header {
        Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://challenges.cloudflare.com https://us-assets.i.posthog.com https://eu-assets.i.posthog.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://t0.gstatic.com https://t2.gstatic.com https://api.qrserver.com https://unpkg.com https://*.tile.openstreetmap.org; connect-src 'self' https://us.i.posthog.com https://eu.i.posthog.com https://us-assets.i.posthog.com https://eu-assets.i.posthog.com https://cloudflareinsights.com https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'; report-uri /api/csp-report;"
    }
    @websockets {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @websockets open-seo:3001 {
        header_up Host localhost
    }
}
